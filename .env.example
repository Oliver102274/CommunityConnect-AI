# CommunityConnect AI - environment variables (TEMPLATE)
#
# Copy this file to .env (project root) and fill in your own values locally.
# NEVER commit .env or put real credentials in this file.
# All Snowflake authentication stays on the backend - never in the frontend.

# --- Option 1 (recommended): named connection from ~/.snowflake/connections.toml
# Uses the same saved connection as the Snowflake CLI / Cortex Code, so no
# credentials are stored in this project. Leave empty to use Option 2.
SNOWFLAKE_CONNECTION_NAME=

# --- Option 2: key-pair authentication (servers / Render)
# SNOWFLAKE_ACCOUNT + SNOWFLAKE_USER below, plus the PEM private key text.
# Newlines may be written as \n. Never commit the key file.
SNOWFLAKE_PRIVATE_KEY=
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# --- Option 3: username + password (only if your account allows password login)
SNOWFLAKE_ACCOUNT=your_account_identifier_here
SNOWFLAKE_USER=your_username_here
SNOWFLAKE_PASSWORD=your_password_here
# Optional, defaults to "snowflake" (password authentication)
SNOWFLAKE_AUTHENTICATOR=your_authenticator_here

# --- Shared settings (optional; defaults shown in comments)
# Database and schema containing RESOURCES and RESOURCE_SEARCH (default COMMUNITYCONNECT_DB / PUBLIC)
SNOWFLAKE_DATABASE=your_database_here
SNOWFLAKE_SCHEMA=your_schema_here
SNOWFLAKE_WAREHOUSE=your_warehouse_here
SNOWFLAKE_ROLE=your_role_here
# Cortex model used by AI_COMPLETE (default llama3.3-70b)
CORTEX_MODEL=
